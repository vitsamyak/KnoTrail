{
  "name": "knotrail",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run backend:build && npm run frontend:build",
    "start": "next start",
    "lint": "next lint",
    "test": "node --env-file-if-exists=.env.local --no-warnings --test src/__tests__/*.test.mjs",
    "backend:dev": "node --env-file-if-exists=.env.local --watch --experimental-strip-types backend/server.ts",
    "backend:build": "tsc -p tsconfig.backend.json --noEmit && esbuild backend/server.ts --bundle --platform=node --target=node20 --format=esm --packages=external --outfile=dist/backend/server.js && node -e \"require('fs').writeFileSync('dist/package.json', JSON.stringify({type:'module'}))\"",
    "backend:start": "node dist/backend/server.js",
    "frontend:build": "next build",
    "frontend:start": "next start"
  },
  "engines": {
    "node": ">=20.18.0"
  },
  "dependencies": {
    "@google/genai": "^3.0.0",
    "@supabase/supabase-js": "^2.119.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "next": "14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "unpdf": "^2.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "esbuild": "^0.28.2",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.4.5"
  }
}
