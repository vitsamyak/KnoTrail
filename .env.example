# ==============================================================================
# KnoTrail Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (Vercel & Local Development)
# ------------------------------------------------------------------------------
# Points the Next.js frontend to the standalone Express backend.
# In local development, if unset, defaults to http://localhost:4000.
# In production on Vercel, this MUST be set to your active Render service URL.
NEXT_PUBLIC_API_BASE_URL=https://knotrail-backend.onrender.com

# ------------------------------------------------------------------------------
# BACKEND CONFIGURATION (Render & Local Development)
# ------------------------------------------------------------------------------
PORT=4000
NODE_ENV=development

# Storage backend: "supabase" (production) or "file" (local offline testing)
STORAGE_BACKEND=supabase

# Remote Supabase Credentials
SUPABASE_URL=https://<your-project-id>.supabase.co
SUPABASE_SECRET_KEY=<your-supabase-service-role-key>
SUPABASE_STORAGE_BUCKET=knotrail-source-files

# Google Gemini AI API Key
GEMINI_API_KEY=<your-google-ai-studio-api-key>
GEMINI_MODEL=gemini-3.5-flash

# Cryptographic Session Secret (Required for production HMAC tokens)
SESSION_SECRET=<random-64-character-hex-string>

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=https://knotrail.vercel.app,http://localhost:3000,http://127.0.0.1:3000
